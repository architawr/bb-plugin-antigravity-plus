{
  "name": "bb-plugin-antigravity-plus",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "author": "tymshe",
  "description": "First-class Antigravity CLI ACP provider for BB with native system prompts, tip forking, manual compaction, xhigh/max reasoning, Swarm board tab, and macOS/Linux/Windows support.",
  "files": [
    "server.ts",
    "host.ts",
    "app.tsx",
    "cli.ts",
    "background-tasks.ts",
    "subagents.ts",
    "dialect.ts",
    "prompt-mode.ts",
    "mode-controls.ts",
    "usage.ts",
    "maintenance.ts",
    "swarm-contract.ts",
    "swarm-board.ts",
    "acp-proxy.ts",
    "agy-fork.ts",
    "dist/*.js",
    "dist/*.css",
    "dist/*.meta.json",
    "!dist/*.map",
    "README.md",
    "LICENSE",
    "PLUGIN_OVERVIEW.md",
    "SECURITY.md",
    "docs",
    "assets",
    "skills"
  ],
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104 <0.7",
    "node": ">=22"
  },
  "bb": {
    "name": "Antigravity Plus",
    "description": "Antigravity CLI for BB with native system prompts, tip forking, manual compaction, xhigh/max reasoning, native Swarm board panel, per-session isolation, and macOS support.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "bb plugin build",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tymshe/bb-plugin-antigravity-plus.git"
  }
}
